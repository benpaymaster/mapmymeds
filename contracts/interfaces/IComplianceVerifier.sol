pragma solidity 0.8.33;

/// @title IComplianceVerifier
/// @notice Matches the verifier contract generated by Barretenberg (`bb write_solidity_verifier`) for the
///         Noir circuit in `circuits/transfer_compliance`.
/// @dev Public inputs, in order:
///      [0] listing commitment, [1] nullifier, [2] fulfilling pharmacy address as a field element.
interface IComplianceVerifier {
    function verify(bytes calldata proof, bytes32[] calldata publicInputs) external view returns (bool);
}
