# Copy to .env and fill in. Never put a private key here: deploy with `--account deployer`
# (an encrypted Foundry keystore created with `cast wallet import deployer --interactive`).

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
ETHERSCAN_API_KEY=            # Etherscan v2 key, works for Basescan

# Admin: a Safe multisig. It must call acceptOwnership() on each contract after deploy.
OWNER=
# Off-chain attestor that signs pharmacy registrations (separate key from OWNER).
ATTESTOR=

# zkVerify aggregation contract on this network: https://docs.zkverify.io/overview/contract-addresses
ZKVERIFY_AGGREGATION=
ZKVERIFY_DOMAIN_ID=0
# keccak256 of circuits/transfer_compliance/target/proof/vk (run circuits/transfer_compliance/prove.sh first):
#   cast keccak "0x$(xxd -p -c 99999 circuits/transfer_compliance/target/proof/vk)"
VK_HASH=
# sha256("ultrahonk:v3.0") is used if unset (bb 3.0.x)
VERSION_HASH=

# Chainlink Data Feeds for this network: https://data.chain.link (filter by Base / Base Sepolia)
ETH_USD_FEED=
GBP_USD_FEED=
# L2 Sequencer Uptime Feed (Base mainnet): https://docs.chain.link/data-feeds/l2-sequencer-feeds
SEQUENCER_UPTIME_FEED=
ETH_USD_HEARTBEAT=1200
GBP_USD_HEARTBEAT=86400
REGISTRATION_FEE_PENCE=2000

# Durin L2Registry for mapmymeds.eth, created at https://durin.dev (optional)
DURIN_REGISTRY=
